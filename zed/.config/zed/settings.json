// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "split",
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    }
  },
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "fast": false,
        "model": "sonnet",
        "effort": "default",
        "mode": "auto"
      },
      "type": "registry"
    }
  },
  "edit_predictions": {
    "mode": "subtle",
    "provider": "zed",
  },
  "agent": {
    "profiles": {},
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.5",
    },
    "default_profile": "write",
    "play_sound_when_agent_done": "never",
  },
  "base_keymap": "VSCode",
  "file_types": {
    "markdown": ["*.rmd"],
  },
  "show_edit_predictions": false,
  "soft_wrap": "bounded",
  "minimap": {
    "show": "auto",
  },
  "cursor_blink": false,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Catppuccin Macchiato",
  },
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte - No Italics",
    "dark": "Catppuccin Frappé - No Italics",
  },
  // Core editor behavior
  "preferred_line_length": 88,
  "buffer_font_size": 13,
  "ui_font_size": 15,

  // Vim mode + behavior
  "vim_mode": true,

  "terminal": {
    "font_size": 13,
    "detect_venv": {
      "on": {
        // Default directories to search for virtual environments, relative
        // to the current working directory. We recommend overriding this
        // in your project's settings, rather than globally.
        "directories": [".env", "env", ".venv", "venv"],
        // Can also be `csh`, `fish`, and `nushell`
        "activate_script": "default",
      },
    },
  },
  "languages": {
    "LaTeX": {
      "show_edit_predictions": true,
    },
    "reST": {
      "show_edit_predictions": true,
    },
    "TypeScript": {
      "show_edit_predictions": false,
    },
    "Python": {
      // "language_servers": ["ruff"],
      // Or, if there are other language servers you want to use with Python
      "show_edit_predictions": true,
      "language_servers": ["ruff", "pyright"],
      "formatter": [
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
    },
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "profiles": {
    "Focus": {
      "settings": {
        "ui_font_size": 14,
        "buffer_font_size": 14,
        "buffer_line_height": {
          "custom": 2.0
        },
        "tab_bar": {
          "show": false,
          "show_nav_history_buttons": false
        },
        "toolbar": {
          "breadcrumbs": false,
          "quick_actions": false
        },
        "gutter": {
          "line_numbers": false,
          "folds": false,
          "breakpoints": false,
          "runnables": false,
          "min_line_number_digits": 0
        },
        "indent_guides": {
          "enabled": false
        },
        "current_line_highlight": "none",
        "scrollbar": {
          "show": "never",
          "cursors": false,
          "git_diff": false,
          "diagnostics": "none",
          "search_results": false,
          "selected_symbol": false
        }
      }
    },
  },
}
